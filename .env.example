# ─── Cyber-SentinelBaran1886 — ملف البيئة ───────────────────────────────
# انسخ هذا الملف إلى .env ثم ضع قيمك. ملف .env محجوب بـ .gitignore ولن يُرفع.
# كل المفاتيح هنا لها طبقات مجانية — لا حاجة لأي خدمة مدفوعة.

# ── الطبقة 2: عقل الذكاء الاصطناعي (اختر واحداً على الأقل، أو لا تضع شيئاً) ──
# Google Gemini (1500 طلب/يوم مجاناً): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (مجاني وسريع جداً): https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (نماذج مجانية): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama محلي (بدون أي مفتاح خارجي): ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── الطبقة 3: قاعدة البيانات (Supabase المجانية) ─────────────────────────
# https://supabase.com → New project → Settings → API
# شغّل محتوى supabase/schema.sql في SQL Editor مرة واحدة.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── الطبقة 4: التنبيه الفوري (بوت تليجرام) ──────────────────────────────
# 1) تحدث مع @BotFather → /newbot  2) أرسل رسالة لبوتك ثم افتح:
#    https://api.telegram.org/bot<TOKEN>/getMe وخذ chat.id من response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── أهداف الفحص (افصل بفاصلة) ───────────────────────────────────────────
SCAN_TARGETS=https://example.com

# ── اختياري: فحص مستودعات GitHub إضافية ─────────────────────────────────
GITHUB_TOKEN=
